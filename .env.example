# Copy to .env for local development (server.js reads process.env).
# NEVER commit .env — it is gitignored.
# NEVER paste the bot token into chat, the repo, or client-side code.

# Required — from @BotFather (your bot's token)
TELEGRAM_BOT_TOKEN=

# Optional — defaults to the existing bookings group if left empty
TELEGRAM_CHAT_ID=

# Optional — port for the standalone server
PORT=8080
